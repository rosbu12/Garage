# Build locali Flutter (vengono rigenerate)
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
# Nota: le cartelle app/android e app/ios le rigenera la CI con `flutter create`.
# Se un domani le personalizzi (icona, firma) e le vuoi versionare, va bene lo stesso.
